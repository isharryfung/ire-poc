{
  "version": "1.0.0",
  "thresholds": {
    "auto_merge": 0.85,
    "manual_review": 0.5,
    "candidate_gap": 0.1
  },
  "field_priorities": [
    "hkid",
    "emplid",
    "student_id",
    "alumni_id",
    "email",
    "phone",
    "first_name",
    "last_name",
    "date_of_birth",
    "gender",
    "address"
  ],
  "algorithms": [
    "exact_match",
    "jaro_winkler",
    "email_composite",
    "phone_exact_last8",
    "token_jaccard"
  ],
  "candidate_limit": 25,
  "full_scan_limit": 50,
  "min_comparable_fields": 2,
  "safety": {
    "require_minimum_fields": true,
    "block_if_conflicting_verified_fields": true
  }
}
